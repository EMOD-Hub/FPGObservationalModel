Bootstrap: docker
From: ghcr.io/emod-hub/emod-ubuntu-runtime:latest
Stage: spython-base

%post
# Install the ObsModel packages
pip3 install --no-cache-dir "fpg-observational-model==1.0.1.dev1"

# Install the emod_api package
pip3 install --no-cache-dir "emod-api>=1.35.1,<2"

%environment
export TZ=UTC
export PIP_ROOT_USER_ACTION=ignore

%runscript
exec /bin/bash "$@"

%startscript
exec /bin/bash "$@"
